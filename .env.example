# Root by default; use 0.4.1-rootless for UID:GID 10001:10001.
KEEPSYNC_IMAGE=mayankfawkes/keepsync:0.4.1
KEEPSYNC_SOURCE=./data
KEEPSYNC_TARGET=s3://your-bucket/keepsync/files
KEEPSYNC_INTERVAL=1h
KEEPSYNC_SNAPSHOTS_ENABLED=true
KEEPSYNC_SNAPSHOT_INTERVAL=24h
KEEPSYNC_SNAPSHOT_RETAIN=14
# For S3-compatible storage, set its origin (no bucket or path).
KEEPSYNC_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_DEFAULT_REGION=us-east-1
