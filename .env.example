KEEPSYNC_IMAGE=mayankfawkes/keepsync:0.3.0
KEEPSYNC_SOURCE=./data
KEEPSYNC_DATASET=files
KEEPSYNC_TARGET=s3://your-bucket/keepsync/files
KEEPSYNC_METHOD=live
KEEPSYNC_INTERVAL=1h
KEEPSYNC_DEBOUNCE=30s
KEEPSYNC_MAX_WAIT=5m
KEEPSYNC_SNAPSHOTS_ENABLED=true
KEEPSYNC_SNAPSHOT_INTERVAL=30m
KEEPSYNC_SNAPSHOT_RETAIN=7
KEEPSYNC_CPUS=0.5
KEEPSYNC_MEMORY_LIMIT=256m
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_DEFAULT_REGION=us-east-1
