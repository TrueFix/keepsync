{
  "dataset": "personal-files",
  "source": "/data",
  "repository": "s3://my-backup-bucket/keepsync/personal-files",
  "state_dir": "/var/lib/keepsync",
  "restore_root": "/restore",
  "interval": "1h",
  "method": "live",
  "debounce": "2s",
  "max_wait": "30s",
  "watch_mode": "auto",
  "watch_interval": "5s",
  "max_watches": 8192,
  "delete_remote": false,
  "log_format": "text",
  "log_level": "info",
  "log_files": true,
  "log_color": true,
  "excludes": ["**/.cache/**", "**/node_modules/**"],
  "snapshots": {
    "enabled": true,
    "interval": "24h",
    "keep_last": 14
  }
}
