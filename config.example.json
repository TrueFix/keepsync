{
  "dataset": "personal-files",
  "source": "/data",
  "repository": "s3://my-backup-bucket/keepsync/personal-files",
  "password_file": "/run/secrets/restic_password",
  "state_dir": "/var/lib/keepsync",
  "restore_root": "/restore",
  "interval": "1h",
  "method": "live",
  "debounce": "30s",
  "max_wait": "5m",
  "max_watches": 8192,
  "delete_remote": false,
  "log_format": "text",
  "log_level": "info",
  "log_files": true,
  "restic": "restic",
  "excludes": ["**/.cache/**", "**/node_modules/**"],
  "snapshots": {
    "enabled": false,
    "interval": "24h",
    "keep_last": 7
  }
}
